# 이 파일을 `.env.local` 로 복사해서 값을 채운다.
#
#   cp .env.example .env.local
#
# `.env.local` 은 .gitignore 에 걸려 있다. 절대 커밋하지 마라.
# 변수 이름은 CLAUDE.md 의 "환경변수" 표가 정본이다 — 임의로 바꾸면 phase 간에 어긋난다.
# NEXT_PUBLIC_ 접두사는 브라우저에 노출된다. 토큰·시크릿에는 절대 붙이지 마라.


# ─────────────────────────────────────────────────────────────
# 사이트 (blog-2 / blog-4)
# ─────────────────────────────────────────────────────────────
# 절대 URL 생성용 (RSS · sitemap · OG 이미지).
# 로컬에서는 비워두면 http://localhost:3000 이 기본값으로 쓰인다.
NEXT_PUBLIC_SITE_URL=


# ─────────────────────────────────────────────────────────────
# 조회수 — Turso (blog-2 이후 별도 단계)
# ─────────────────────────────────────────────────────────────
#   brew install tursodatabase/tap/turso
#   turso auth login
#   turso db create ai-blog
#   turso db show ai-blog --url        → TURSO_DATABASE_URL
#   turso db tokens create ai-blog     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# ─────────────────────────────────────────────────────────────
# 댓글 — Giscus / GitHub Discussions (blog-2 이후 별도 단계)
# ─────────────────────────────────────────────────────────────
# 1. 레포 Settings → General → Features → Discussions 체크 (레포가 public 이어야 한다)
# 2. Discussions 탭에서 Comments 카테고리 생성 (형식: Announcements)
# 3. https://github.com/apps/giscus 에서 해당 레포에 앱 설치
# 4. https://giscus.app 에서 아래 4개 값 발급
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=


# ─────────────────────────────────────────────────────────────
# 관리자 인증 — Auth.js v5 (blog-3)
# ─────────────────────────────────────────────────────────────
# AUTH_SECRET 생성:  npx auth secret     (또는 openssl rand -base64 32)
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# /admin 접근을 허용할 GitHub 로그인 아이디. 콤마로 구분.
ADMIN_GITHUB_LOGINS=


# ─────────────────────────────────────────────────────────────
# 발행 커밋 — GitHub Contents API (blog-3)
# ─────────────────────────────────────────────────────────────
# OAuth 토큰을 쓰지 않고 별도 PAT 을 쓴다 — 권한 범위를 이 레포 하나로 가두기 위해서다.
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access: 이 레포만 선택
#   Permissions → Repository permissions → Contents: Read and write
GITHUB_CONTENT_REPO=          # owner/repo 형식 (예: brachio9/ai-blog)
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_TOKEN=


# ─────────────────────────────────────────────────────────────
# 이미지 업로드 — Cloudflare R2 (blog-3)
# ─────────────────────────────────────────────────────────────
# Cloudflare 대시보드 → R2 → 버킷 생성 → Settings 에서 공개 도메인 연결
# R2 → Manage API Tokens 에서 액세스 키 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=           # 예: https://assets.example.com
